aux2.pins.4.mode @AUX2_PIN4_MODE@
aux2.pins.4.pull @AUX2_PIN4_PULL@

# --- SPI --------------------------------------------------------------
# The MA600 will not hold the 12MHz default over the breakout cable.
aux2.spi.mode @AUX2_SPI_MODE@
aux2.spi.rate_hz @AUX2_SPI_RATE_HZ@
aux2.spi.filter_us @AUX2_SPI_FILTER_US@
aux2.spi.bct @AUX2_SPI_BCT@
aux2.spi.trim @AUX2_SPI_TRIM@

# --- UART -------------------------------------------------------------
# Must stay 0 while the SPI pins above are in use; mode 5 is what caused
# the uart_pin_error.
aux2.uart.mode @AUX2_UART_MODE@
aux2.uart.baud_rate @AUX2_UART_BAUD_RATE@
aux2.uart.poll_rate_us @AUX2_UART_POLL_RATE_US@
aux2.uart.cui_amt21_address @AUX2_UART_CUI_AMT21_ADDRESS@
