# 0-based indices into the source list above.
motor_position.commutation_source @COMMUTATION_SOURCE@
motor_position.output.source @OUTPUT_SOURCE@

# --- Gearbox ----------------------------------------------------------
# Output turns per rotor turn.  A reducer is < 1 (4x reduction = 0.25);
# 1.0 is a direct drive.  A value > 1.0 faults unless
# rotor_to_output_override is set, which guards against a mistyped ratio.
#
# Set this BEFORE tuning servo.pid_position: the PID gains are in physical
# units at the OUTPUT, i.e. after this scaling, so changing the ratio later
# silently changes what those gains mean.
motor_position.rotor_to_output_ratio @ROTOR_TO_OUTPUT_RATIO@

# --- Safety limits ----------------------------------------------------
# Bounds on position-mode travel, in output rotations.  nan disables a
# bound.  Starting outside the range faults; leaving it during operation
# means no torque is applied to travel further out.
servopos.position_min @SERVOPOS_POSITION_MIN@
servopos.position_max @SERVOPOS_POSITION_MAX@

# Maximum phase current, i.e. the torque ceiling regardless of what any
# command asks for.  RAISING THIS ABOVE THE FACTORY VALUE CAN DAMAGE THE
# HARDWARE -- the controller's own rating applies even if the motor is
# rated higher.  Set it from whichever of the two is lower.
servo.max_current_A @SERVO_MAX_CURRENT_A@

# Speed past which output power is cut back -- a backstop, not a
# trajectory limit.
servo.max_velocity @SERVO_MAX_VELOCITY@

# Trajectory limits used to REACH a target, in output rev/s and rev/s^2.
# Bare boards ship with both unset, and with neither set the firmware
# takes commands immediately: velocity changes instantaneously and "may
# grow to arbitrary magnitude".  They are set here so the first position
# command ramps instead of slamming to target.  nan unsets either one.
servo.default_velocity_limit @SERVO_DEFAULT_VELOCITY_LIMIT@
servo.default_accel_limit @SERVO_DEFAULT_ACCEL_LIMIT@
