# Build output.  build/current_config.cfg is generated by configure_file from
# config/current_config.cfg.in, which is the file under version control.
build/

# Per-run CSV telemetry from direct_motor_test.  One file per run, and output
# rather than source.  Calibration logs are different: they are measurements
# of the motor, so they live in data/calibration/ under version control.
logs/

# Python virtualenv holding tview + moteus_tool.  Recreate with:
#   python3 -m venv moteus-venv && ./moteus-venv/bin/pip install moteus moteus-gui
moteus-venv/

# Upstream mjbots/moteus checkout.  This is a plain clone, not a submodule --
# re-clone it rather than committing it:
#   git clone https://github.com/mjbots/moteus.git
moteus/

# Editor and OS noise
*.swp
*~
.DS_Store

# PlatformIO build output (Teensy firmware)
.pio/

# Telemetry post-processing.  The raw .bin captures already fall under
# logs/ above; these are the derived artefacts, regenerable from the .bin
# by decode.py and therefore not worth versioning either.
*.parquet
tools/telemetry/__pycache__/
